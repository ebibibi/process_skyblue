# Process SkyBlue Configuration
# このファイルをコピーして .env を作成し、各値を設定してください
# cp .env.example .env

# Bluesky Settings
# App Password の使用を推奨: https://bsky.app/settings/app-passwords
BLUESKY_IDENTIFIER=your-account.bsky.social
BLUESKY_PASSWORD=your-app-password

# Discord Webhook for Error Notifications（必須）
# エラー通知・投稿成功通知の送信先
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-url

# Discord Webhook for the mirror channel（必須）
# BlueSkyの投稿をミラーする唯一の出力先。未設定だと何もすることがないので起動時に終了する
DISCORD_LOG_WEBHOOK_URL=https://discord.com/api/webhooks/your-ebilog-webhook-url

# X input (optional: X -> BlueSky mirror and read-only content export)
# Use OAuth 2.0 user-context tokens for the developer app owner so reads qualify
# for X's lower-cost "Owned Read" pricing.
X_USER_ID=your-numeric-x-user-id
X_SCREEN_NAME=your-x-screen-name
X_CLIENT_ID=your-oauth2-client-id
X_CLIENT_SECRET=your-oauth2-client-secret
X_ACCESS_TOKEN=your-oauth2-access-token
X_REFRESH_TOKEN=your-oauth2-refresh-token
BLUESKY_MIRROR_HANDLE=your-account.bsky.social
X_ENV_FILE=/absolute/path/to/process_bluesky/.env

# Application Settings
# ポーリング間隔（秒）。最小10・最大3600
POLLING_INTERVAL=60

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
